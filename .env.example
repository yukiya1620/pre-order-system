APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS配信の本番環境ではtrueにする(Cookieが平文のHTTP通信で送られないようにするため)。
# ローカル開発(http://127.0.0.1等)ではfalse(未設定)のままにする。
# SESSION_SECURE_COOKIE=true

# ブラウザからのAPIアクセスをセッション認証(Cookie)として扱ってよいドメインの一覧(カンマ区切り)。
# ここに含まれないOriginからのリクエストはセッション認証が確立されない(Sanctumのstateful判定)。
# ローカル開発用のデフォルト値で足りない場合(本番ドメインを追加する場合等)のみ設定する。
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 一般公開デモ環境専用。trueの場合のみ、DEMO_SMS_PHONE_NUMBERSに登録した
# 電話番号に限りSMS認証コードをAPIレスポンスへ含める。通常環境ではfalse(未設定)のままにする。
DEMO_MODE=false
DEMO_SMS_PHONE_NUMBERS=

# 一般公開デモの操作チュートリアル(ガイドツアー)が画面上で案内する、
# 実際にログインできるデモ用の資格情報。DEMO_MODE=trueのときのみ使われ、
# 未設定(空)の場合はチュートリアルが該当の案内を表示しないだけで、
# チュートリアル自体は動作する。詳細はdocs/demo-deployment.mdを参照。
# 例: DEMO_TUTORIAL_BUYER_PHONE=00000000001
DEMO_TUTORIAL_BUYER_PHONE=
# 例: DEMO_TUTORIAL_FARMER_EMAIL=demo-farmer@example.com
DEMO_TUTORIAL_FARMER_EMAIL=
# 実際のパスワードはこのファイル・Gitに書かない。Xserver側の.envにのみ設定する。
DEMO_TUTORIAL_FARMER_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
